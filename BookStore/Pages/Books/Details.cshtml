@page "{id:guid}"
@model BookStore.Pages.Books.DetailsModel
@{
    ViewData["Title"] = Model.Book?.Title ?? "書籍";
}

@if (Model.Book is null)
{
    <div class="alert alert-warning">找不到此書籍。</div>
}
else
{
    <div class="row g-4">
        <div class="col-md-4">
            <img src="@(string.IsNullOrEmpty(Model.Book.CoverImageUrl) ? "https://placehold.co/400x600" : Model.Book.CoverImageUrl)" class="img-fluid rounded shadow-sm" alt="@Model.Book.Title" />
        </div>
        <div class="col-md-8">
            <h1 class="display-6">@Model.Book.Title</h1>
            <p class="lead text-muted">@Model.Book.Author</p>
            <p><strong>分類：</strong>@Model.Category?.Name</p>
            <p><strong>出版日期：</strong>@Model.Book.PublishedOn.ToString("yyyy/MM/dd")</p>
            <p><strong>價格：</strong><span class="text-primary fw-semibold">$@Model.Book.Price</span></p>
            <div class="mb-3">
                @foreach (var tag in Model.Book.Tags)
                {
                    <span class="badge badge-tag">@tag</span>
                }
            </div>
            <p class="fs-5">@Model.Book.Description</p>
            <a asp-page="/Books/Index" class="btn btn-outline-secondary">返回列表</a>
        </div>
    </div>

    <hr class="my-5" />

    <section>
        <h2 class="h4 mb-3">相關書籍推薦</h2>
        @if (!Model.RelatedBooks.Any())
        {
            <p class="text-muted">目前沒有相關書籍推薦。</p>
        }
        else
        {
            <div class="row g-4">
                @foreach (var book in Model.RelatedBooks)
                {
                    <div class="col-md-6 col-xl-3">
                        <div class="card h-100 book-card">
                            <img src="@(string.IsNullOrEmpty(book.CoverImageUrl) ? "https://placehold.co/400x600" : book.CoverImageUrl)" class="card-img-top" alt="@book.Title" />
                            <div class="card-body">
                                <h3 class="h5 card-title">@book.Title</h3>
                                <p class="card-subtitle text-muted mb-2">@book.Author</p>
                                <a asp-page="/Books/Details" asp-route-id="@book.Id" class="stretched-link">查看內容</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}
