@page
@model BookStore.Pages.Books.IndexModel
@{
    ViewData["Title"] = "找書";
}

<h1 class="mb-4">找書</h1>

<form method="get" class="card mb-4 shadow-sm">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label" asp-for="CategoryId">分類</label>
                <select asp-for="CategoryId" class="form-select" asp-items="new SelectList(Model.Categories, nameof(Category.Id), nameof(Category.Name), Model.CategoryId)">
                    <option value="">全部分類</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="Keyword">關鍵字</label>
                <input asp-for="Keyword" class="form-control" placeholder="書名、作者或簡介" />
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="SortBy">排序</label>
                <select asp-for="SortBy" class="form-select">
                    <option value="Newest">最新出版</option>
                    <option value="Title">書名 (A-Z)</option>
                    <option value="Author">作者 (A-Z)</option>
                    <option value="PriceLowToHigh">價格由低到高</option>
                    <option value="PriceHighToLow">價格由高到低</option>
                    <option value="Popularity">熱門度</option>
                </select>
            </div>
            <div class="col-md-2">
                <div class="form-check mb-2">
                    <input class="form-check-input" asp-for="MatchTag" />
                    <label class="form-check-label" asp-for="MatchTag">包含標籤</label>
                </div>
                <button type="submit" class="btn btn-primary w-100">搜尋</button>
            </div>
        </div>
    </div>
</form>

@if (!Model.Books.Any())
{
    <div class="alert alert-info">找不到符合條件的書籍，請調整搜尋條件再試一次。</div>
}
else
{
    <p class="text-muted">共找到 <strong>@Model.Books.Count</strong> 本書。</p>
    <div class="row g-4">
        @foreach (var book in Model.Books)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card book-card h-100">
                    <div class="row g-0 h-100">
                        <div class="col-4">
                            <img src="@(string.IsNullOrEmpty(book.CoverImageUrl) ? "https://placehold.co/200x300" : book.CoverImageUrl)" class="img-fluid rounded-start h-100 object-fit-cover" alt="@book.Title" />
                        </div>
                        <div class="col-8">
                            <div class="card-body d-flex flex-column">
                                <h3 class="h5 card-title mb-1">@book.Title</h3>
                                <p class="card-subtitle text-muted mb-2">@book.Author</p>
                                <p class="small text-muted mb-2">出版日期：@book.PublishedOn.ToString("yyyy/MM/dd")</p>
                                <p class="flex-grow-1">@(string.IsNullOrWhiteSpace(book.Description) ? "尚無簡介" : book.Description)</p>
                                <div class="d-flex align-items-center justify-content-between mt-2">
                                    <span class="fw-semibold text-primary">$@book.Price</span>
                                    <a class="btn btn-outline-primary btn-sm" asp-page="Details" asp-route-id="@book.Id">查看</a>
                                </div>
                                <div class="mt-2">
                                    @foreach (var tag in book.Tags)
                                    {
                                        <span class="badge badge-tag">@tag</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
